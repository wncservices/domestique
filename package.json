{
  "name": "domestique",
  "private": true,
  "description": "Shared cycling route library that syncs to Garmin and Wahoo.",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wncservices/domestique.git"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "npm --workspace @domestique/web run dev",
    "build": "npm --workspace @domestique/web run build",
    "lint": "npm --workspace @domestique/web run lint",
    "typecheck": "npm --workspace @domestique/web run typecheck"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "@tiptap/core": "^3.30.4",
    "typescript": "5.9.3"
  }
}
